Aquí tienes el código limpio, estrictamente de 3 caracteres (sin signos + ni -) y trabajando únicamente con días laborables (Lunes a Viernes):
 * Sábados y domingos quedan excluidos del mapa de días.
 * Si un día fijo del mes (D01, D26...) cae en sábado o domingo, pasa automáticamente al Lunes (salvo si ese ajuste se saliera del mes actual en días como D30 o D31, en cuyo caso se queda en el Viernes de ese mismo mes).
 * Si el último día del mes (L00) cae en sábado o domingo, retrocede automáticamente al Viernes.
Código para Google Apps Script (Código.gs)
// Solo días laborables (Lunes = 1 a Viernes = 5)
const MAPA_DIAS_LAB = {
  "LU": 1,
  "MA": 2,
  "MI": 3,
  "JU": 4,
  "VI": 5
};

const NOMBRES_DIAS = [
  "Domingo", "Lunes", "Martes", "Miércoles", "Jueves", "Viernes", "Sábado"
];

/**
 * Devuelve el día de la semana laborable (Lunes a Viernes) según el código de 3 caracteres.
 * Soporta celdas individuales o rangos enteros: =OBTENER_DIA_CODIGO(A2:A50; $Z$1)
 *
 * @param {string|Array} codigo Código exacto de 3 caracteres (ej: "W01", "WUL", "D01", "D26", "L00", "3MI").
 * @param {Date} [fechaRef] Opcional. Fecha de referencia (por defecto hoy).
 * @return {string} Nombre del día laborable de la semana.
 * @customfunction
 */
function OBTENER_DIA_CODIGO(codigo, fechaRef) {
  const fechaBase = fechaRef ? new Date(fechaRef) : new Date();

  // Soporte para aplicar a toda una columna de golpe (ARRAYFORMULA)
  if (Array.isArray(codigo)) {
    return codigo.map(fila => fila.map(celda => 
      celda ? evaluarCodigoLaborable_(celda, fechaBase) : ""
    ));
  }

  return evaluarCodigoLaborable_(codigo, fechaBase);
}

function evaluarCodigoLaborable_(codigoRaw, fecha) {
  if (!codigoRaw || typeof codigoRaw !== "string") return "";

  const codigo = codigoRaw.toUpperCase().trim();
  if (codigo.length !== 3) return "Código inválido";

  const anio = fecha.getFullYear();
  const mes = fecha.getMonth();
  const ultimoDiaMes = new Date(anio, mes + 1, 0).getDate();

  const prefijo = codigo.charAt(0);
  const objetivo = codigo.substring(1, 3);

  // 1. Todos los días laborables (A00)
  // Si se consulta en sábado o domingo, devuelve el Lunes
  if (codigo === "A00") {
    let d = fecha.getDay();
    if (d === 0 || d === 6) d = 1;
    return NOMBRES_DIAS[d];
  }

  // 2. Primer y último día de la semana (W01 = Lunes, WUL = Viernes)
  if (codigo === "W01") return NOMBRES_DIAS[1]; // Lunes
  if (codigo === "WUL") return NOMBRES_DIAS[5]; // Viernes

  // 3. Días de la semana fijos o N-ésimos del mes (ALU, AJU, 3MI, LVI...)
  if (objetivo in MAPA_DIAS_LAB) {
    if (prefijo === "A" || prefijo === "L" || (prefijo >= "1" && prefijo <= "5")) {
      return NOMBRES_DIAS[MAPA_DIAS_LAB[objetivo]];
    }
    return "Código inválido";
  }

  // 4. Día fijo del mes ajustado a laborable (D01 a D31)
  if (prefijo === "D" && !isNaN(objetivo)) {
    const num = parseInt(objetivo, 10);
    if (num < 1 || num > 31) return "Código inválido";

    const diaNum = Math.min(num, ultimoDiaMes);
    let d = new Date(anio, mes, diaNum).getDay();

    // Si cae en Sábado (6) o Domingo (0), avanza al Lunes (1)
    // Salvo que al avanzar nos salgamos del mes, en cuyo caso retrocede al Viernes (5)
    if (d === 6) {
      d = (diaNum + 2 <= ultimoDiaMes) ? 1 : 5;
    } else if (d === 0) {
      d = (diaNum + 1 <= ultimoDiaMes) ? 1 : 5;
    }
    return NOMBRES_DIAS[d];
  }

  // 5. Último día laborable del mes (L00)
  if (codigo === "L00") {
    let d = new Date(anio, mes, ultimoDiaMes).getDay();
    if (d === 6 || d === 0) d = 5; // Si fin de mes es Sábado o Domingo -> Viernes
    return NOMBRES_DIAS[d];
  }

  return "Código inválido";
}

Tabla definitiva de códigos (3 caracteres exactos, 100% laborables)
| Código | Qué representa | Resultado (siempre Lun-Vie) |
|---|---|---|
| A00 | Todos los días | El día laborable actual |
| W01 | Primer día de la semana | Lunes |
| WUL | Último día de la semana | Viernes |
| ALU, AMA, AMI, AJU, AVI | Todos los lunes, martes, miércoles, jueves, viernes | Lunes ... Viernes |
| 1LU a 5VI (ej. 3MI) | 1º, 2º, 3º, 4º o 5º [día] del mes | El día indicado (Miércoles) |
| LLU a LVI (ej. LVI) | Último [día] del mes | El día indicado (Viernes) |
| D01 | Primer día del mes | El día que caiga el 1 (si es finde, Lunes) |
| D02 a D31 (ej. D26) | Día X del mes | El día que caiga (si es finde, salta al Lunes) |
| L00 | Último día del mes | El día que caiga fin de mes (si es finde, Viernes) |
