function calcularFechaExactaDelCodigo_(codigoRaw, referenciaSemana) {
  // 1. Limpiar y buscar si trae modificador de días (+X o -X al final)
  const codigoLimpio = codigoRaw.toUpperCase().trim();
  const matchModificador = codigoLimpio.match(/^([A-Z0-9]{3})([+-]\d+)$/);
  
  let codigoBase = codigoLimpio;
  let diasOffset = 0;

  if (matchModificador) {
    codigoBase = matchModificador[1];
    diasOffset = parseInt(matchModificador[2], 10); // Ej: -2 o +1
  }

  const anio = referenciaSemana.getFullYear();
  const mes = referenciaSemana.getMonth();
  const ultimoDiaMes = new Date(anio, mes + 1, 0).getDate();

  const prefijo = codigoBase.charAt(0);
  const objetivo = codigoBase.substring(1, 3);
  let fechaEncontrada = null;

  // --- CÁLCULO DE LA FECHA BASE ---
  if (codigoBase === "A00") {
    fechaEncontrada = new Date(referenciaSemana);
  }
  else if (codigoBase === "W01") {
    fechaEncontrada = new Date(referenciaSemana); // Lunes
  }
  else if (codigoBase === "WUL") {
    let viernes = new Date(referenciaSemana);
    viernes.setDate(viernes.getDate() + 4);
    fechaEncontrada = viernes;
  }
  else if (prefijo === "D" && !isNaN(objetivo)) {
    const num = parseInt(objetivo, 10);
    if (num >= 1 && num <= 31) {
      const diaNum = Math.min(num, ultimoDiaMes);
      let d = new Date(anio, mes, diaNum);
      let dow = d.getDay();
      if (dow === 6) d.setDate(d.getDate() + (diaNum + 2 <= ultimoDiaMes ? 2 : -1));
      else if (dow === 0) d.setDate(d.getDate() + (diaNum + 1 <= ultimoDiaMes ? 1 : -2));
      fechaEncontrada = d;
    }
  }
  else if (codigoBase === "L00") {
    let d = new Date(anio, mes, ultimoDiaMes);
    let dow = d.getDay();
    if (dow === 6) d.setDate(d.getDate() - 1);
    if (dow === 0) d.setDate(d.getDate() - 2);
    fechaEncontrada = d;
  }
  else if (objetivo in MAPA_DIAS_LAB) {
    const diaMeta = MAPA_DIAS_LAB[objetivo];
    let contador = 0;

    if (prefijo === "A" || (prefijo >= "1" && prefijo <= "5")) {
      const n = (prefijo === "A") ? 1 : parseInt(prefijo, 10);
      for (let dia = 1; dia <= ultimoDiaMes; dia++) {
        let temp = new Date(anio, mes, dia);
        // Comprobamos que sea laborable (Lun-Vie) para que coincida con tu lógica
        if (temp.getDay() === diaMeta) {
          contador++;
          if (contador === n) {
            fechaEncontrada = temp;
            break;
          }
        }
      }
    } else if (prefijo === "L") {
      for (let dia = ultimoDiaMes; dia >= 1; dia--) {
        let temp = new Date(anio, mes, dia);
        if (temp.getDay() === diaMeta) {
          fechaEncontrada = temp;
          break;
        }
      }
    }
  }

  // Si no se pudo calcular la fecha base, devolvemos null
  if (!fechaEncontrada) return null;

  // --- APLICAR EL DESPLAZAMIENTO (+X o -X) SI LO TIENE ---
  if (diasOffset !== 0) {
    fechaEncontrada.setDate(fechaEncontrada.getDate() + diasOffset);
  }

  return fechaEncontrada;
}

